# Build outputs
build/
app/build/
.gradle/
.kotlin/
*.apk
*.msi
*.dmg
DerivedData/

# Machine-specific
local.properties
.idea/
xcuserdata/
*.xcuserstate
.DS_Store

# Swift package build state
ios/BlackoutCore/.build/
ios/BlackoutCore/.swiftpm/

# llama.cpp binary (75 MB): run ios/Vendor/fetch-llama.sh, which downloads the pinned release and checks its SHA-256
ios/Vendor/llama.framework/

# AI models are downloaded by the app on the phone, never committed
*.gguf
# The AI engine is fetched by the build (desktop/build.gradle.kts, fetchAiEngine), never committed
desktop/engine/*/llama/
desktop/engine/*/llama-gpu/
desktop/engine/*/tor/
!desktop/engine/common/llama/
!desktop/engine/common/tor/
