<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys Xcode generates from the INFOPLIST_KEY_* build settings. -->
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_blackout-mesh._tcp</string>
		<string>_darkproof._tcp</string>
		<string>_blackout-mesh._udp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Group invites: darkproof://join?name=...&code=... (Invite.swift) -->
			<key>CFBundleURLName</key>
			<string>it.darkproof.mesh.invite</string>
			<key>CFBundleURLSchemes</key>
			<array><string>darkproof</string></array>
		</dict>
	</array>
	<!-- The screen iOS shows while the app starts: black like the app, also when the iPhone is in light mode
	     (the generated one took the system background, a white flash). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
</dict>
</plist>
